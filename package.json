{
  "name": "reely-tidy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "test:watch": "vp test",
    "dev": "vp dev",
    "build": "vue-tsc -b && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "vp config --no-agent"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.13.0",
      "onFail": "download"
    }
  }
}
